[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/rwandaos/dream.png'
picture-uri-dark='file:///usr/share/backgrounds/rwandaos/wildlife.png'
picture-options='zoom'
primary-color='#00A1DE'
secondary-color='#0b1b34'

[org/gnome/desktop/interface]
font-name='Google Sans 11'
document-font-name='Google Sans 11'
monospace-font-name='DejaVu Sans Mono 11'
color-scheme='prefer-dark'
gtk-theme='MacTahoe-Dark'
gtk-icon-theme-name='MacTahoe'
accent-color='blue'

[org/gnome/shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com','dash-to-dock@micxgx.gmail.com','blur-my-shell@aunetx']
favorite-apps=['org.gnome.TextEditor.desktop','org.gnome.Nautilus.desktop','org.gnome.Terminal.desktop','firefox-esr.desktop','org.gnome.Calculator.desktop','gnome-control-center.desktop']

[org/gnome/shell/extensions/user-theme]
name='MacTahoe-Dark'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
custom-theme-shrink=true
dash-max-icon-size=48
background-opacity=0.2
